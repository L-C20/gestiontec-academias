# Servidor
PORT=3000
NODE_ENV=development

# PostgreSQL
# Ojo: en este entorno local PostgreSQL escucha en el puerto 5000, no el 5432 por defecto.
# En producción (Railway/Render/Supabase) esto vendrá como una sola DATABASE_URL.
PGHOST=localhost
PGPORT=5000
PGDATABASE=gestiontec_academias
PGUSER=postgres
PGPASSWORD=
# node-pg-migrate usa esta URL para correr las migraciones (debe reflejar los valores de arriba)
DATABASE_URL=postgres://usuario:password@localhost:5000/gestiontec_academias

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CORS
CORS_ORIGIN=http://localhost:5500
